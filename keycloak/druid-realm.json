{
  "realm": "druid",
  "enabled": true,
  "accessTokenLifespan": 120,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "druid",
      "name": "Druid web console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "druid-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:8888/*", "http://localhost:9888/*"],
      "webOrigins": ["http://localhost:8888"]
    },
    {
      "clientId": "druid-jwt",
      "name": "client_secret_jwt test (scripts/client_auth_methods.sh)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret-jwt",
      "secret": "druid-client-secret",
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:9888/*"]
    },
    {
      "clientId": "druid-public",
      "name": "none / public client test (scripts/client_auth_methods.sh)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:9888/*"]
    }
  ],
  "users": [
    {
      "username": "alice", "enabled": true, "emailVerified": true,
      "firstName": "Alice", "lastName": "Admin", "email": "alice@example.com",
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }]
    },
    {
      "username": "bob", "enabled": true, "emailVerified": true,
      "firstName": "Bob", "lastName": "Reader", "email": "bob@example.com",
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }]
    }
  ]
}
